{
  "manifest_version": 3,
  "name": "AccessLens",
  "version": "0.1.0",
  "description": "A simple prototype interface for public-service websites.",
  "action": {
    "default_title": "AccessLens",
    "default_popup": "index.html"
  },
  "permissions": ["storage"],
  "host_permissions": ["http://localhost:4000/*"],
  "background": {
    "service_worker": "assets/background.js"
  },
  "content_scripts": [
    {
      "matches": [
        "<all_urls>"
      ],

      "js": ["assets/contentScript.js"]
    }
  ]
}
