{
  "manifest_version": 3,
  "name": "AccessLens",
  "version": "0.1.0",
  "description": "A simple prototype interface for public-service websites.",
  "action": {
    "default_title": "AccessLens",
    "default_popup": "index.html"
  },
  "permissions": [],
  "host_permissions": ["http://localhost:4000/*"],
  "content_scripts": [
    {
      "matches": [
        "https://www.selenium.dev/selenium/web/web-form.html",
        "https://*.gov.lk/*",
        "http://*.gov.lk/*"
      ],
      "js": ["assets/contentScript.js"]
    }
  ]
}
